# Login do painel
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSAO_SEGREDO=troque-este-segredo

# Domínio apontado para a VM (o Caddy emite o certificado HTTPS sozinho)
DOMINIO=aniversarios.exemplo.duckdns.org

# Opcionais
# PORTA=3000
# STORAGE_DIR=./storage
# INTERVALO_CICLO_MIN=15
# WHATSAPP_DESATIVADO=1   # desenvolvimento sem WhatsApp
# WHATSAPP_LOG=warn
# LOG_NIVEL=info
# TAG=latest              # tag da imagem no GHCR (ex.: sha-1a2b3c4)

# Monitoramento (recomendado): URL de ping do healthchecks.io ou serviço compatível.
# Configure o check com período de 15 min e tolerância de 30 min.
# MONITOR_URL=https://hc-ping.com/seu-uuid

# Backup fora da VM com rclone (configure antes com: rclone config)
# BACKUP_REMOTO=gcs:meu-bucket/aniversarios
