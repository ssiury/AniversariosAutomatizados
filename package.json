{
  "name": "aniversarios-automatizados",
  "version": "1.0.0",
  "description": "Envia automaticamente a arte de aniversário dos membros do Ministério de Mídia para o grupo do WhatsApp",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js | pino-pretty",
    "test": "NODE_ENV=test TZ=America/Sao_Paulo node --test 'test/**/*.test.js'",
    "test:cobertura": "NODE_ENV=test TZ=America/Sao_Paulo node --test --experimental-test-coverage --test-coverage-exclude='test/**' 'test/**/*.test.js'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "verificar": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.1.1",
    "cookie-session": "^2.1.1",
    "eta": "^4.6.0",
    "express": "^5.3.0",
    "htmx.org": "^2.0.11",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^5.9.3"
  },
  "imports": {
    "#config": "./src/config.js",
    "#compartilhado/*": "./src/compartilhado/*",
    "#modulos/*": "./src/modulos/*"
  }
}
