<% layout('../layout', { titulo: 'Dashboard' }) %>
<% const rotuloStatus = { aguardando: 'Aguardando', enviado: 'Enviado', falhou: 'Falhou', teste: 'Teste' }; %>
<% const avatar = (m) => `<span class="avatar ${m.template?.tipo ?? ''}">${m.foto ? `<img src="/storage/${m.foto}" alt="" loading="lazy">` : it.h.iniciais(m.nome)}</span>`; %>

<header class="cabecalho">
  <div>
    <h1>Dashboard</h1>
    <p>Hoje é <%= it.h.formatarDiaMes(it.hoje) %>.</p>
  </div>
  <a class="botao secundario" href="/membros/novo"><%~ it.h.icone('plus') %>Novo membro</a>
</header>

<div class="pilha-secoes">
  <section class="indicadores" aria-label="Resumo">
    <div class="cartao indicador">
      <div class="indicador-topo">Aniversariantes hoje <span class="chip-icone"><%~ it.h.icone('cake') %></span></div>
      <span class="indicador-valor"><%= it.deHoje.length %></span>
      <span class="indicador-legenda"><%= it.deHoje.length ? 'Artes enviadas no horário configurado' : 'Nenhum aniversário hoje' %></span>
    </div>
    <div class="cartao indicador">
      <div class="indicador-topo">Neste mês <span class="chip-icone"><%~ it.h.icone('calendar-days') %></span></div>
      <span class="indicador-valor"><%= it.doMes.length %></span>
      <span class="indicador-legenda">Aniversariantes em <%= it.h.nomeMes(it.mesAtual) %></span>
    </div>
    <div class="cartao indicador">
      <div class="indicador-topo">Membros ativos <span class="chip-icone"><%~ it.h.icone('users') %></span></div>
      <span class="indicador-valor"><%= it.totais.ativos %></span>
      <span class="indicador-legenda"><%= it.totais.inativos %> inativo<%= it.totais.inativos === 1 ? '' : 's' %></span>
    </div>
    <div class="cartao indicador">
      <div class="indicador-topo">Por template <span class="chip-icone"><%~ it.h.icone('palette') %></span></div>
      <div class="distribuicao">
        <span class="cor-masculino" title="Masculino"><%~ it.h.icone('mars') %><%= it.porTemplate.masculino %></span>
        <span class="cor-feminino" title="Feminino"><%~ it.h.icone('venus') %><%= it.porTemplate.feminino %></span>
        <span class="cor-infantil" title="Infantil"><%~ it.h.icone('baby') %><%= it.porTemplate.infantil %></span>
      </div>
      <span class="indicador-legenda">Masculino, feminino e infantil</span>
    </div>
  </section>

  <section class="cartao">
    <div class="cartao-cabecalho">
      <h2>Aniversariantes de hoje</h2>
    </div>
    <div class="cartao-corpo">
      <% if (!it.deHoje.length) { %>
        <div class="vazio"><%~ it.h.icone('cake') %>Ninguém faz aniversário hoje.</div>
      <% } else { %>
        <div class="grade-artes">
          <% for (const m of it.deHoje) { %>
            <a class="arte" href="/membros/<%= m.id %>">
              <img src="/membros/<%= m.id %>/previa.jpg?w=400" alt="Prévia da arte de <%= m.nome %>" loading="lazy">
              <div class="arte-info">
                <strong><%= m.nome %></strong>
                <small><%= m.idade %> anos · <%= m.template?.nome %></small>
                <span class="selo <%= m.situacao.status %>"><%= rotuloStatus[m.situacao.status] %><%= m.situacao.status === 'falhou' ? ` ${m.situacao.falhas}/3` : '' %></span>
              </div>
            </a>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>

  <div class="colunas">
    <section class="cartao">
      <div class="cartao-cabecalho"><h2>Próximos 7 dias</h2></div>
      <div class="cartao-corpo sem-topo">
        <% if (!it.proximos7.length) { %>
          <div class="vazio"><%~ it.h.icone('calendar-days') %>Nenhum aniversário nos próximos 7 dias.</div>
        <% } else { %>
          <ul class="lista">
            <% for (const m of it.proximos7) { %>
              <li>
                <%~ avatar(m) %>
                <span class="principal">
                  <a href="/membros/<%= m.id %>"><%= m.nome %></a>
                  <small><%= it.h.formatarDiaMes(m.proximo_aniversario) %> · faz <%= m.idade + 1 %> anos</small>
                </span>
                <span class="pilula <%= m.dias_ate === 1 ? 'destaque' : '' %>"><%= m.dias_ate === 1 ? 'amanhã' : `em ${m.dias_ate} dias` %></span>
              </li>
            <% } %>
          </ul>
        <% } %>
      </div>
    </section>

    <section class="cartao">
      <div class="cartao-cabecalho"><h2>Saúde do sistema</h2></div>
      <div class="cartao-corpo sem-topo">
        <ul class="lista saude">
          <li>
            <span class="rotulo"><%~ it.h.icone('smartphone') %>WhatsApp</span>
            <% if (it.saude.whatsapp.conectado) { %>
              <span class="selo conectado">Conectado</span>
            <% } else { %>
              <a class="selo desconectado" href="/configuracoes">Desconectado</a>
            <% } %>
          </li>
          <li>
            <span class="rotulo"><%~ it.h.icone('message-circle') %>Grupo</span>
            <% if (it.saude.grupo) { %><strong><%= it.saude.grupo %></strong><% } else { %><a class="selo desconectado" href="/configuracoes">Não configurado</a><% } %>
          </li>
          <li>
            <span class="rotulo"><%~ it.h.icone('clock') %>Próximo envio</span>
            <strong><%= it.saude.proximoEnvio %></strong>
          </li>
        </ul>
      </div>
    </section>
  </div>

  <div class="colunas">
    <section class="cartao">
      <div class="cartao-cabecalho">
        <h2>Aniversariantes de <%= it.h.nomeMes(it.mesAtual) %></h2>
        <span class="pilula"><%= it.doMes.length %></span>
      </div>
      <div class="cartao-corpo sem-topo">
        <% if (!it.doMes.length) { %>
          <div class="vazio"><%~ it.h.icone('calendar-days') %>Nenhum aniversariante neste mês.</div>
        <% } else { %>
          <ul class="lista">
            <% for (const m of it.doMes) { %>
              <li>
                <span class="data-bloco"><strong><%= it.h.dia(m.data_nascimento) %></strong><small><%= it.h.mesCurto(m.data_nascimento) %></small></span>
                <span class="principal">
                  <a href="/membros/<%= m.id %>"><%= m.nome %></a>
                  <small><%= m.template?.nome %></small>
                </span>
                <% if (m.dias_ate === 0) { %><span class="pilula destaque">hoje</span><% } %>
              </li>
            <% } %>
          </ul>
        <% } %>
      </div>
    </section>

    <section class="cartao">
      <div class="cartao-cabecalho">
        <h2>Últimos envios</h2>
        <% if (it.ultimos.length) { %><a class="link-acao" href="/historico">Ver histórico<%~ it.h.icone('chevron-right') %></a><% } %>
      </div>
      <div class="cartao-corpo sem-topo">
        <% if (!it.ultimos.length) { %>
          <div class="vazio"><%~ it.h.icone('send') %>Nenhum envio ainda.</div>
        <% } else { %>
          <ul class="lista">
            <% for (const e of it.ultimos) { %>
              <li>
                <span class="principal">
                  <a href="/membros/<%= e.membro_id %>"><%= e.membro_nome %></a>
                  <small><%= it.h.formatarDataHora(e.criado_em) %><%= e.template_nome ? ` · ${e.template_nome}` : '' %></small>
                </span>
                <span class="selo <%= e.status %>"><%= rotuloStatus[e.status] %></span>
              </li>
            <% } %>
          </ul>
        <% } %>
      </div>
    </section>
  </div>
</div>
