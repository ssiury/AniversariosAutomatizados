<% const h = it.h; const wa = it.wa; %>
<section id="whatsapp" class="cartao" <% if (!wa.conectado && !wa.desativado) { %>hx-get="/configuracoes/whatsapp" hx-trigger="every 3s" hx-swap="outerHTML"<% } %>>
  <div class="cartao-cabecalho">
    <h2><%= wa.conectado ? 'WhatsApp' : 'Conectar WhatsApp' %></h2>
    <% if (wa.conectado) { %><span class="pilula ok"><span class="ponto"></span>Conectado</span>
    <% } else if (!wa.desativado) { %><span class="pilula aviso"><span class="ponto"></span>Desconectado</span><% } %>
  </div>

  <% if (wa.desativado) { %>
    <p class="alerta neutro"><%~ h.icone('info') %><span><%= wa.erro %></span></p>
  <% } else if (wa.conectado) { %>
    <div class="conectado-info">
      <span class="icone-caixa ok"><%~ h.icone('smartphone') %></span>
      <div><b>Aparelho conectado</b><div class="sutil numero"><%= wa.numero ? '+' + wa.numero : 'Número não identificado' %></div></div>
    </div>
    <form method="post" action="/configuracoes/whatsapp/desconectar" style="margin-top: 20px" onsubmit="return confirm('Desconectar o WhatsApp? Será preciso ler um novo QR Code.')">
      <button class="botao perigo pequeno">Desconectar</button>
    </form>
  <% } else { %>
    <div class="area-qr">
      <% if (wa.qr) { %>
        <img class="qr" src="<%= wa.qr %>" alt="QR Code para conectar o WhatsApp">
      <% } else { %>
        <div class="qr"><%~ h.icone('qr-code') %><span>Gerando o QR Code…</span></div>
      <% } %>
    </div>
    <ol class="passos">
      <li><i>1</i><span>Abra o WhatsApp no celular que vai publicar.</span></li>
      <li><i>2</i><span>Toque em <b>Dispositivos conectados</b> e depois em <b>Conectar dispositivo</b>.</span></li>
      <li><i>3</i><span>Aponte a câmera para o código acima.</span></li>
    </ol>
    <form method="post" action="/configuracoes/whatsapp/desconectar" style="margin-top: 20px">
      <button class="botao secundario pequeno"><%~ h.icone('refresh-cw') %>Gerar novo código</button>
    </form>
  <% } %>
  <% if (wa.erro && !wa.desativado) { %><p class="alerta falha" role="alert" style="margin-top: 16px"><%~ h.icone('circle-alert') %><span><%= wa.erro %></span></p><% } %>
</section>
