<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.titulo ? it.titulo + ' · ' : '' %>Aniversários</title>
  <link rel="stylesheet" href="/static/estilo.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<body>
<% if (it.usuario) { %>
  <header class="topo">
    <a class="marca" href="/">🎂 Aniversários</a>
    <nav>
      <% const links = [['/', 'Dashboard'], ['/membros', 'Membros'], ['/templates', 'Templates'], ['/historico', 'Histórico'], ['/configuracoes', 'Configurações']]; %>
      <% for (const [href, rotulo] of links) { %>
        <% const ativo = href === '/' ? it.caminho === '/' : (it.caminho || '').startsWith(href); %>
        <a href="<%= href %>" class="<%= ativo ? 'ativo' : '' %>"><%= rotulo %></a>
      <% } %>
    </nav>
    <form method="post" action="/logout"><button class="link">Sair</button></form>
  </header>
<% } %>
  <main class="conteudo"><%~ it.body %></main>
</body>
</html>
