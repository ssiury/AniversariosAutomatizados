<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.titulo ? it.titulo + ' · ' : '' %>Aniversários</title>
  <meta name="color-scheme" content="light dark">
  <script>
    // Aplica o tema antes da primeira pintura, para não piscar. Preferência salva > tema do sistema.
    (function () {
      var tema;
      try { tema = localStorage.getItem('tema'); } catch (e) {}
      if (tema !== 'claro' && tema !== 'escuro') {
        tema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'escuro' : 'claro';
      }
      document.documentElement.dataset.tema = tema;
    })();
  </script>
  <link rel="preload" href="/static/fontes/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/static/fontes/bricolage-grotesque-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/estilo.css">
  <script src="/static/htmx.min.js" defer></script>
</head>
<% const botaoTema = `
  <button type="button" class="botao-icone" data-alternar-tema aria-label="Alternar entre tema claro e escuro" title="Alternar tema">
    <span class="so-claro">${it.h.icone('moon')}</span><span class="so-escuro">${it.h.icone('sun')}</span>
  </button>`; %>
<% const marca = `
  <span class="logo">${it.h.icone('cake')}</span>
  <div><b>Aniversários</b><small>Ministério de Mídia</small></div>`; %>
<body>
<% if (it.usuario) { %>
  <% const links = [
    ['/', 'Dashboard', 'Início', 'layout-dashboard'],
    ['/membros', 'Membros', 'Membros', 'users'],
    ['/templates', 'Templates', 'Artes', 'palette'],
    ['/historico', 'Histórico', 'Histórico', 'history'],
    ['/configuracoes', 'Configurações', 'Ajustes', 'sliders-vertical'],
  ]; %>
  <% const ativo = (href) => (href === '/' ? it.caminho === '/' : (it.caminho || '').startsWith(href)); %>
  <% const wa = it.whatsapp || {}; %>
  <header class="topo">
    <a href="/" class="marca"><%~ marca %></a>
    <nav class="pilulas" aria-label="Menu principal">
      <% for (const [href, rotulo, , icone] of links) { %>
        <a href="<%= href %>" <%~ ativo(href) ? 'aria-current="page"' : '' %>><%~ it.h.icone(icone) %><span><%= rotulo %></span></a>
      <% } %>
    </nav>
    <div class="topo-direita">
      <% if (wa.conectado) { %>
        <a href="/configuracoes" class="estado-whatsapp conectado" aria-label="WhatsApp conectado"><i></i><span>WhatsApp conectado</span></a>
      <% } else if (!wa.desativado) { %>
        <a href="/configuracoes" class="estado-whatsapp" aria-label="WhatsApp desconectado: conectar"><i></i><span>WhatsApp desconectado</span></a>
      <% } %>
      <%~ botaoTema %>
      <form method="post" action="/logout">
        <button class="botao-icone" aria-label="Sair" title="Sair"><%~ it.h.icone('log-out') %></button>
      </form>
    </div>
  </header>

  <main class="conteudo"><%~ it.body %></main>

  <nav class="abas" aria-label="Navegação">
    <% for (const [href, , curto, icone] of links) { %>
      <a href="<%= href %>" <%~ ativo(href) ? 'aria-current="page"' : '' %>><%~ it.h.icone(icone) %><span><%= curto %></span></a>
    <% } %>
  </nav>
<% } else { %>
  <main class="tela-login">
    <%~ botaoTema %>
    <%~ it.body %>
  </main>
<% } %>
  <script>
    // Interações pequenas por delegação de eventos. Sem JavaScript, os formulários funcionam do mesmo jeito.
    (function () {
      var HEX = /^#[0-9a-f]{6}$/i;

      function marcarCor(hex) {
        document.querySelectorAll('[data-cor]').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.dataset.cor.toLowerCase() === hex.toLowerCase()));
        });
      }
      function aplicarCor(hex) {
        var campo = document.getElementById('cor_destaque');
        var seletor = document.querySelector('[data-seletor-cor]');
        if (campo) campo.value = hex.toUpperCase();
        if (seletor) seletor.value = hex.toLowerCase();
        marcarCor(hex);
      }

      document.addEventListener('click', function (evento) {
        var alvo = evento.target;

        if (alvo.closest('[data-alternar-tema]')) {
          var raiz = document.documentElement;
          var tema = raiz.dataset.tema === 'escuro' ? 'claro' : 'escuro';
          raiz.dataset.tema = tema;
          try { localStorage.setItem('tema', tema); } catch (e) {}
          return;
        }

        var cor = alvo.closest('[data-cor]');
        if (cor) return aplicarCor(cor.dataset.cor);

        var variavel = alvo.closest('[data-variavel]');
        if (variavel) {
          var texto = document.getElementById(variavel.dataset.alvo);
          if (!texto) return;
          var ini = texto.selectionStart, fim = texto.selectionEnd, valor = variavel.dataset.variavel;
          texto.setRangeText(valor, ini, fim, 'end');
          texto.focus();
        }
      });

      document.addEventListener('input', function (evento) {
        var alvo = evento.target;
        if (alvo.matches('[data-seletor-cor]')) aplicarCor(alvo.value);
        if (alvo.id === 'cor_destaque' && HEX.test(alvo.value)) {
          var seletor = document.querySelector('[data-seletor-cor]');
          if (seletor) seletor.value = alvo.value.toLowerCase();
          marcarCor(alvo.value);
        }
      });

      // Mostra o nome do arquivo escolhido (ou arrastado) na área de upload.
      document.addEventListener('change', function (evento) {
        var alvo = evento.target;
        if (!alvo.matches('.soltar input[type=file]') || !alvo.files.length) return;
        var rotulo = alvo.closest('.soltar').querySelector('[data-arquivo]');
        if (rotulo) rotulo.textContent = alvo.files[0].name;
      });
    })();
  </script>
</body>
</html>
