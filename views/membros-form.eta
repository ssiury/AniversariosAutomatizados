<% layout('./layout', { titulo: it.novo ? 'Novo membro' : it.membro.nome }) %>
<% const m = it.membro; const e = it.erros || {}; %>
<p><a href="/membros">← Membros</a></p>
<h1><%= it.novo ? 'Novo membro' : m.nome %></h1>
<% if (it.ok) { %><p class="alerta sucesso"><%= it.ok === 'criado' ? 'Membro cadastrado.' : 'Alterações salvas.' %></p><% } %>
<% if (it.aviso === 'foto') { %><p class="alerta erro">Membro salvo, mas a foto não pôde ser lida.</p><% } %>

<div class="colunas">
  <form class="cartao pilha" method="post" enctype="multipart/form-data" action="<%= it.novo ? '/membros' : '/membros/' + m.id %>">
    <label>Nome
      <input name="nome" value="<%= m.nome || '' %>" required maxlength="120">
      <% if (e.nome) { %><small class="erro"><%= e.nome %></small><% } %>
    </label>
    <label>Data de nascimento (com o ano)
      <input type="date" name="data_nascimento" value="<%= m.data_nascimento || '' %>" required min="1900-01-01">
      <% if (e.data_nascimento) { %><small class="erro"><%= e.data_nascimento %></small><% } %>
    </label>
    <fieldset>
      <legend>Sexo</legend>
      <label class="inline"><input type="radio" name="sexo" value="M" <%= m.sexo === 'M' ? 'checked' : '' %> required> Masculino</label>
      <label class="inline"><input type="radio" name="sexo" value="F" <%= m.sexo === 'F' ? 'checked' : '' %>> Feminino</label>
      <% if (e.sexo) { %><small class="erro"><%= e.sexo %></small><% } %>
    </fieldset>
    <label class="inline"><input type="checkbox" name="ativo" <%= m.ativo ? 'checked' : '' %>> Ativo (recebe a arte no aniversário)</label>
    <label>Foto
      <% if (m.foto) { %><img class="foto-atual" src="/storage/<%= m.foto %>" alt="Foto de <%= m.nome %>"><% } %>
      <input type="file" name="foto" accept="image/*">
      <small class="sutil">Sem foto, a arte mostra as iniciais.</small>
      <% if (e.foto) { %><small class="erro"><%= e.foto %></small><% } %>
    </label>
    <% if (m.foto) { %><label class="inline"><input type="checkbox" name="remover_foto"> Remover foto</label><% } %>
    <label>Template fixo (opcional)
      <select name="template_fixo_id">
        <option value="">Automático (pela idade e sexo)</option>
        <% for (const t of it.templates) { %>
          <option value="<%= t.id %>" <%= m.template_fixo_id === t.id ? 'selected' : '' %>><%= t.nome %></option>
        <% } %>
      </select>
      <% if (e.template_fixo_id) { %><small class="erro"><%= e.template_fixo_id %></small><% } %>
    </label>
    <button class="botao">Salvar</button>
  </form>

  <% if (!it.novo) { %>
  <section class="cartao">
    <h2>Prévia da arte</h2>
    <p class="sutil">Próximo aniversário: <%= it.h.formatarBR(m.proximo_aniversario) %>
      (<%= m.dias_ate === 0 ? 'hoje!' : `em ${m.dias_ate} dia(s)` %>) · template <strong><%= m.template?.nome %></strong></p>
    <img class="previa" src="/membros/<%= m.id %>/previa.jpg?w=540&v=<%= Date.now() %>" alt="Prévia da arte">
    <button class="botao" hx-post="/membros/<%= m.id %>/enviar" hx-target="#resultado-envio"
      hx-confirm="Enviar a arte de <%= m.nome %> para o grupo agora?" hx-disabled-elt="this">Enviar agora</button>
    <div id="resultado-envio"></div>
    <form method="post" action="/membros/<%= m.id %>/excluir" onsubmit="return confirm('Excluir este membro e o histórico de envios dele?')">
      <button class="botao perigo">Excluir membro</button>
    </form>
  </section>
  <% } %>
</div>
