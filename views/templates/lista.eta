<% layout('../layout', { titulo: 'Templates' }) %>
<header class="cabecalho">
  <div>
    <h1>Templates</h1>
    <p>Fundo, cores e textos das três artes de aniversário.</p>
  </div>
</header>

<div class="pilha-secoes">
  <div class="cartao cartao-corpo formulario">
    <div class="regra">
      <strong>Ordem de escolha:</strong>
      <span>Template fixo do membro</span><%~ it.h.icone('chevron-right') %>
      <span class="etiqueta infantil">Infantil, abaixo da idade limite</span><%~ it.h.icone('chevron-right') %>
      <span class="etiqueta feminino">Feminino</span><%~ it.h.icone('chevron-right') %>
      <span class="etiqueta masculino">Masculino</span>
    </div>
    <p class="regra"><%~ it.h.icone('info') %>Na mensagem do WhatsApp, use <code>{nome}</code> <code>{idade}</code> <code>{data}</code> <code>{ministerio}</code>.</p>
  </div>

  <div class="grade-templates">
  <% for (const t of it.lista) { %>
    <form id="template-<%= t.id %>" class="cartao cartao-corpo formulario" method="post" action="/templates/<%= t.id %>" enctype="multipart/form-data">
      <div class="template-cabecalho">
        <span class="etiqueta <%= t.tipo %>"><%= t.nome %></span>
      </div>
      <% if (Number(it.ok) === t.id) { %><p class="alerta sucesso" role="status"><%~ it.h.icone('circle-check') %><span>Template salvo.</span></p><% } %>
      <% if (Number(it.erro) === t.id) { %><p class="alerta erro" role="alert"><%~ it.h.icone('circle-alert') %><span>Não foi possível ler a imagem de fundo.</span></p><% } %>
      <img class="previa" src="/templates/<%= t.id %>/previa.jpg?w=480&v=<%= Date.now() %>" alt="Prévia do template <%= t.nome %>" loading="lazy">

      <label class="campo"><span>Nome no painel</span>
        <input name="nome" value="<%= t.nome %>" required maxlength="60">
      </label>
      <label class="campo"><span>Fundo</span>
        <input type="file" name="fundo" accept="image/*">
        <small><%= t.fundo ? 'Fundo personalizado. Ideal: 1080×1350 px.' : 'Usando o fundo padrão na cor de destaque. Ideal: 1080×1350 px.' %></small>
      </label>
      <% if (t.fundo) { %>
        <label class="interruptor"><input type="checkbox" name="remover_fundo"><span>Voltar ao fundo padrão</span></label>
      <% } %>
      <label class="campo"><span>Cor de destaque</span>
        <span class="linha-cor">
          <input type="color" name="cor_destaque" value="<%= t.cor_destaque %>" oninput="this.nextElementSibling.textContent = this.value">
          <code><%= t.cor_destaque %></code>
        </span>
      </label>
      <label class="campo"><span>Frase da arte</span>
        <textarea name="mensagem_arte" rows="2" maxlength="80"><%= t.mensagem_arte %></textarea>
        <small>Até 2 linhas.</small>
      </label>
      <label class="campo"><span>Mensagem do WhatsApp</span>
        <textarea name="legenda" rows="5" maxlength="1000"><%= t.legenda %></textarea>
      </label>
      <button class="botao">Salvar template</button>
    </form>
  <% } %>
  </div>
</div>
