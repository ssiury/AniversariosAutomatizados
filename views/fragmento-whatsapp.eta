<div id="whatsapp" <% if (!it.wa.conectado && !it.wa.desativado) { %>hx-get="/configuracoes/whatsapp" hx-trigger="every 3s" hx-swap="outerHTML"<% } %>>
  <% if (it.wa.desativado) { %>
    <p class="alerta erro"><%= it.wa.erro %></p>
  <% } else if (it.wa.conectado) { %>
    <p><span class="selo enviado">Conectado</span> <%= it.wa.numero ? '+' + it.wa.numero : '' %></p>
    <form method="post" action="/configuracoes/whatsapp/desconectar" onsubmit="return confirm('Desconectar o WhatsApp? Será preciso escanear um novo QR Code.')">
      <button class="botao perigo">Desconectar</button>
    </form>
  <% } else if (it.wa.qr) { %>
    <p>Abra o WhatsApp no celular → <strong>Aparelhos conectados</strong> → <strong>Conectar um aparelho</strong> e escaneie:</p>
    <img class="qr" src="<%= it.wa.qr %>" alt="QR Code do WhatsApp">
  <% } else { %>
    <p class="sutil">Conectando ao WhatsApp…</p>
  <% } %>
  <% if (it.wa.erro && !it.wa.desativado) { %><p class="alerta erro"><%= it.wa.erro %></p><% } %>
</div>
