<% layout('../layout', { titulo: 'Membros' }) %>
<header class="cabecalho">
  <div>
    <h1>Membros</h1>
    <p>Cadastro dos membros que recebem a arte de aniversário.</p>
  </div>
  <a class="botao" href="/membros/novo"><%~ it.h.icone('plus') %>Novo membro</a>
</header>

<section class="cartao">
  <form class="barra-filtros" method="get" action="/membros" role="search"
        hx-get="/membros" hx-target="#linhas" hx-push-url="true"
        hx-trigger="input changed delay:300ms from:input[name=busca], change">
    <label class="campo-busca">
      <span class="oculto-visual">Buscar por nome</span>
      <%~ it.h.icone('search') %>
      <input type="search" name="busca" placeholder="Buscar por nome" value="<%= it.filtros.busca %>">
    </label>
    <select name="sexo" aria-label="Sexo">
      <option value="">Todos os sexos</option>
      <option value="M" <%= it.filtros.sexo === 'M' ? 'selected' : '' %>>Masculino</option>
      <option value="F" <%= it.filtros.sexo === 'F' ? 'selected' : '' %>>Feminino</option>
    </select>
    <select name="situacao" aria-label="Situação">
      <option value="">Ativos e inativos</option>
      <option value="ativo" <%= it.filtros.situacao === 'ativo' ? 'selected' : '' %>>Somente ativos</option>
      <option value="inativo" <%= it.filtros.situacao === 'inativo' ? 'selected' : '' %>>Somente inativos</option>
    </select>
    <select name="mes" aria-label="Mês de aniversário">
      <option value="">Todos os meses</option>
      <% for (let m = 1; m <= 12; m++) { %>
        <option value="<%= m %>" <%= Number(it.filtros.mes) === m ? 'selected' : '' %>><%= it.h.nomeMes(m)[0].toUpperCase() + it.h.nomeMes(m).slice(1) %></option>
      <% } %>
    </select>
    <noscript><button class="botao secundario">Filtrar</button></noscript>
  </form>

  <div class="tabela-rolavel">
    <table>
      <thead>
        <tr><th>Nome</th><th>Nascimento</th><th>Idade</th><th>Sexo</th><th>Situação</th><th>Template</th></tr>
      </thead>
      <tbody id="linhas"><%~ include('./linhas', it) %></tbody>
    </table>
  </div>
</section>
