<% if (!it.lista.length) { %>
  <tr><td colspan="6" class="sutil">Nenhum membro encontrado.</td></tr>
<% } %>
<% for (const m of it.lista) { %>
  <tr class="<%= m.ativo ? '' : 'inativo' %>">
    <td><a href="/membros/<%= m.id %>"><%= m.nome %></a></td>
    <td><%= it.h.formatarBR(m.data_nascimento) %></td>
    <td><%= m.idade %></td>
    <td><%= m.sexo %></td>
    <td><%= m.ativo ? 'Sim' : 'Não' %></td>
    <td><span class="tag <%= m.template?.tipo %>"><%= m.template?.nome %></span><%= m.template_fixo_id ? ' (fixo)' : '' %></td>
  </tr>
<% } %>
