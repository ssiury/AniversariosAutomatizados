<% if (!it.lista.length) { %>
  <tr><td colspan="6" class="vazio-tabela">Nenhum membro encontrado.</td></tr>
<% } %>
<% for (const m of it.lista) { %>
  <tr class="<%= m.ativo ? '' : 'inativo' %>">
    <td>
      <div class="celula-nome">
        <span class="avatar <%= m.template?.tipo %>"><% if (m.foto) { %><img src="/storage/<%= m.foto %>" alt="" loading="lazy"><% } else { %><%= it.h.iniciais(m.nome) %><% } %></span>
        <a href="/membros/<%= m.id %>"><%= m.nome %></a>
      </div>
    </td>
    <td class="numero"><%= it.h.formatarBR(m.data_nascimento) %></td>
    <td class="numero"><%= m.idade %></td>
    <td><%= it.h.sexo(m.sexo) %></td>
    <td><span class="selo <%= m.ativo ? 'ativo' : 'inativo' %>"><%= m.ativo ? 'Ativo' : 'Inativo' %></span></td>
    <td><span class="etiqueta <%= m.template?.tipo %>"><%= m.template?.nome %><% if (m.template_fixo_id) { %> <small>fixo</small><% } %></span></td>
  </tr>
<% } %>
