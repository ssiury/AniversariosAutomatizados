<% layout('../layout', { titulo: it.novo ? 'Novo membro' : it.membro.nome }) %>
<% const m = it.membro; const e = it.erros || {}; %>

<a class="voltar" href="/membros"><%~ it.h.icone('arrow-left') %>Membros</a>
<header class="cabecalho">
  <div>
    <h1><%= it.novo ? 'Novo membro' : m.nome %></h1>
    <p><%= it.novo ? 'Preencha os dados para incluir o membro nos envios automáticos.' : 'Dados do membro e prévia da próxima arte.' %></p>
  </div>
</header>

<div class="pilha-secoes">
<% if (it.ok) { %><p class="alerta sucesso" role="status"><%~ it.h.icone('circle-check') %><span><%= it.ok === 'criado' ? 'Membro cadastrado.' : 'Alterações salvas.' %></span></p><% } %>
<% if (it.aviso === 'foto') { %><p class="alerta erro" role="alert"><%~ it.h.icone('circle-alert') %><span>Membro salvo, mas a foto não pôde ser lida.</span></p><% } %>

<div class="colunas-formulario">
  <form class="cartao cartao-corpo formulario" method="post" enctype="multipart/form-data" action="<%= it.novo ? '/membros' : '/membros/' + m.id %>">
    <div class="secao-formulario">
      <h3>Dados pessoais</h3>
      <label class="campo"><span>Nome completo</span>
        <input name="nome" value="<%= m.nome || '' %>" required maxlength="120" <%~ e.nome ? 'aria-invalid="true"' : '' %>>
        <% if (e.nome) { %><small class="erro"><%= e.nome %></small><% } %>
      </label>
      <div class="duas-colunas">
        <label class="campo"><span>Data de nascimento</span>
          <input type="date" name="data_nascimento" value="<%= m.data_nascimento || '' %>" required min="1900-01-01" <%~ e.data_nascimento ? 'aria-invalid="true"' : '' %>>
          <% if (e.data_nascimento) { %><small class="erro"><%= e.data_nascimento %></small><% } else { %><small>Com o ano: a idade decide a arte infantil.</small><% } %>
        </label>
        <fieldset class="campo">
          <legend>Sexo</legend>
          <div class="segmentado">
            <label><input type="radio" name="sexo" value="M" <%= m.sexo === 'M' ? 'checked' : '' %> required><%~ it.h.icone('mars') %>Masculino</label>
            <label><input type="radio" name="sexo" value="F" <%= m.sexo === 'F' ? 'checked' : '' %>><%~ it.h.icone('venus') %>Feminino</label>
          </div>
          <% if (e.sexo) { %><small class="erro"><%= e.sexo %></small><% } %>
        </fieldset>
      </div>
    </div>

    <div class="secao-formulario">
      <h3>Foto</h3>
      <div class="foto-campo">
        <span class="avatar <%= m.template?.tipo ?? '' %>"><% if (m.foto) { %><img src="/storage/<%= m.foto %>" alt="Foto de <%= m.nome %>"><% } else { %><%= it.h.iniciais(m.nome) %><% } %></span>
        <label class="campo">
          <span class="oculto-visual">Foto</span>
          <input type="file" name="foto" accept="image/*">
          <% if (e.foto) { %><small class="erro"><%= e.foto %></small><% } else { %><small>JPG, PNG ou HEIC, até 10 MB. Sem foto, a arte mostra as iniciais.</small><% } %>
        </label>
      </div>
      <% if (m.foto) { %>
        <label class="interruptor"><input type="checkbox" name="remover_foto"><span>Remover a foto atual</span></label>
      <% } %>
    </div>

    <div class="secao-formulario">
      <h3>Envio</h3>
      <label class="interruptor">
        <input type="checkbox" name="ativo" <%= m.ativo ? 'checked' : '' %>>
        <span>Membro ativo<small>Recebe a arte no grupo no dia do aniversário.</small></span>
      </label>
      <label class="campo"><span>Template</span>
        <select name="template_fixo_id">
          <option value="">Automático, pela idade e pelo sexo</option>
          <% for (const t of it.templates) { %>
            <option value="<%= t.id %>" <%= m.template_fixo_id === t.id ? 'selected' : '' %>>Sempre <%= t.nome %></option>
          <% } %>
        </select>
        <% if (e.template_fixo_id) { %><small class="erro"><%= e.template_fixo_id %></small><% } %>
      </label>
    </div>

    <div class="acoes">
      <button class="botao"><%= it.novo ? 'Cadastrar membro' : 'Salvar alterações' %></button>
      <a class="botao secundario" href="/membros">Cancelar</a>
    </div>
  </form>

  <% if (!it.novo) { %>
  <section class="cartao fixo-no-topo">
    <div class="cartao-cabecalho">
      <h2>Prévia da arte</h2>
      <span class="etiqueta <%= m.template?.tipo %>"><%= m.template?.nome %></span>
    </div>
    <div class="cartao-corpo formulario">
      <img class="previa" src="/membros/<%= m.id %>/previa.jpg?w=540&v=<%= Date.now() %>" alt="Prévia da arte de <%= m.nome %>">
      <div class="previa-meta">
        <%~ it.h.icone('calendar-days') %>
        <span><%= it.h.formatarDiaMes(m.proximo_aniversario) %></span>
        <span class="pilula <%= m.dias_ate === 0 ? 'destaque' : '' %>"><%= m.dias_ate === 0 ? 'hoje' : m.dias_ate === 1 ? 'amanhã' : `em ${m.dias_ate} dias` %></span>
      </div>
      <div class="acoes">
        <button class="botao" hx-post="/membros/<%= m.id %>/enviar" hx-target="#resultado-envio"
          hx-confirm="Enviar a arte de <%= m.nome %> para o grupo agora?" hx-disabled-elt="this"><%~ it.h.icone('send') %>Enviar agora</button>
      </div>
      <div id="resultado-envio" aria-live="polite"></div>
    </div>
    <div class="cartao-rodape">
      <form method="post" action="/membros/<%= m.id %>/excluir" onsubmit="return confirm('Excluir este membro e o histórico de envios dele?')">
        <button class="botao perigo"><%~ it.h.icone('trash-2') %>Excluir membro</button>
      </form>
    </div>
  </section>
  <% } %>
</div>
</div>
